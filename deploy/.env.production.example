# Copy to deploy/.env.production and replace every sample value.
# Keep the PostgreSQL password URL-safe (letters and numbers only) for the DATABASE_URL assembled by Compose.
POSTGRES_DB=krushinath_sugar
POSTGRES_USER=sugar_user
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password

# Generate each with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_unique_random_secret

WEB_ORIGIN=https://sugar.krushinathgreenenergy.in
VITE_API_BASE_URL=https://sugar-api.krushinathgreenenergy.in/api
WEB_PUBLIC_PORT=8080
API_PUBLIC_PORT=4000

# Create a remotely-managed Cloudflare Tunnel and store its token here locally.
# Do not commit or share this token.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Initial seed settings. Use the verified paper-register opening balances.
OWNER_NAME=Factory Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_unique_password_at_least_12_chars
CONFIRM_INITIAL_BALANCES=false
SEASON_NAME=2026-27
SEASON_START_DATE=2026-10-01
OPENING_L30=0
OPENING_M30=0
OPENING_S1_30=0
OPENING_S2_30=0
CUMULATIVE_L30=0
CUMULATIVE_M30=0
CUMULATIVE_S1_30=0
CUMULATIVE_S2_30=0
